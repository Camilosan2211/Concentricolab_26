}

@layer utilities {
  .font-cal { font-family: 'Cal Sans', sans-serif; }

  /* Gradient text */
  .text-grad {
    background: linear-gradient(135deg,#4D66FF 0%,#828AFF 55%,#FF6D4D 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .text-grad-coral {
    background: linear-gradient(135deg,#FF6D4D 0%,#FF9B7A 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }

  /* Glass — dark */
  .glass {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  .glass-blue {
    background: rgba(77,102,255,0.08);
    border: 1px solid rgba(77,102,255,0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .section-premium {
    @apply max-w-[1400px] mx-auto my-12 rounded-section border border-blue-900/20 dark:border-blue-400/15 bg-blue-950/30 dark:bg-blue-950/35 shadow-2xl backdrop-blur-xl px-6 md:px-8 py-10 md:py-12;
  }

  /* Glass — light mode */
  html.light .glass {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(77, 102, 255, 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  html.light .glass-blue {
    background: rgba(77, 102, 255, 0.05);
    border: 1px solid rgba(77, 102, 255, 0.16);
  }

  html.light .glow-blue  { box-shadow: 0 0 24px rgba(77,102,255,.20); }
  html.light .glow-coral { box-shadow: 0 0 24px rgba(255,109,77,.15); }

  /* Glow */
  .glow-blue  { box-shadow: 0 0 36px rgba(77,102,255,.35); }
  .glow-coral { box-shadow: 0 0 36px rgba(255,109,77,.25); }

  /* Surface light */
 
  .surface { /* dark fallback */ }
}

/* Scrollbar */
::-webkit-scrollbar { width: 4px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(77,102,255,.35); border-radius: 4px; }

/* Progress bar */
#pb {
  position: fixed; top: 0; left: 0; height: 2px; width: 0%;
  background: linear-gradient(90deg,#4D66FF,#41EAFF,#FF6D4D);
  z-index: 9999; pointer-events: none; border-radius: 0 2px 2px 0;
  transition: width .08s linear;
}

/* Custom cursor — theme via CSS variables */
.cur-dot {
  position: fixed; pointer-events: none; z-index: 10000;
  width: 6px; height: 6px; border-radius: 50%; background: var(--cursor-dot);
  transform: translate(-50%,-50%); opacity: 0; will-change: left,top;
  transition: opacity .3s, transform .15s, background .25s;
}
.cur-ring {
  position: fixed; pointer-events: none; z-index: 9999;
  width: 30px; height: 30px; border-radius: 50%;
  border: 1.5px solid var(--cursor-ring);
  transform: translate(-50%,-50%); opacity: 0; will-change: left,top;
  transition: opacity .3s,
    width .2s cubic-bezier(.34,1.56,.64,1), height .2s cubic-bezier(.34,1.56,.64,1),
    border-radius .2s, border-color .25s;
}
.cur-ring.hov { width: 42px; height: 42px; border-color: var(--cursor-ring-hov); }
.cur-ring.lnk { border-radius: 7px; }

@media (pointer:coarse) { .cur-dot,.cur-ring { display:none; } }

/* Global premium film grain (very subtle) */
.film-grain-overlay {
  position: fixed;
  inset: -120%;
  pointer-events: none;
  z-index: 2;
  opacity: 0.024;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(255,255,255,.18) 0.6px, transparent 1.4px),
    radial-gradient(circle at 70% 60%, rgba(255,255,255,.14) 0.8px, transparent 1.6px),
    radial-gradient(circle at 40% 80%, rgba(255,255,255,.12) 0.5px, transparent 1.2px);
  background-size: 160px 160px, 210px 210px, 130px 130px;
  mix-blend-mode: soft-light;
  animation: filmGrainShift 9s steps(8) infinite;
}

@keyframes filmGrainShift {
  0% { transform: translate3d(0, 0, 0); }
  25% { transform: translate3d(-2.2%, 1.8%, 0); }
  50% { transform: translate3d(1.6%, -1.2%, 0); }
  75% { transform: translate3d(-1.4%, -1.8%, 0); }
  100% { transform: translate3d(0, 0, 0); }
}

/* Hero premium depth layers */
.hero-vignette {
  position: absolute;
  inset: -10% -6%;
  pointer-events: none;
  z-index: 1;
  background:
    radial-gradient(ellipse 68% 52% at 50% 45%, rgba(255,255,255,0.04) 0%, transparent 62%),
    radial-gradient(ellipse 120% 90% at 50% 50%, transparent 42%, rgba(0,0,0,0.34) 100%);
}

.hero-brand-aurora {
  position: absolute;
  inset: -20% -10% auto -10%;
  height: 62%;
  pointer-events: none;
  z-index: 1;
  background:
    radial-gradient(ellipse at 22% 45%, rgba(77,102,255,0.2) 0%, transparent 58%),
    radial-gradient(ellipse at 82% 42%, rgba(255,109,77,0.16) 0%, transparent 56%),
    radial-gradient(ellipse at 52% 85%, rgba(130,138,255,0.13) 0%, transparent 60%);
  filter: blur(46px);
  opacity: 0.62;
  animation: auroraDrift 14s ease-in-out infinite alternate;
}
.hero-brand-aurora-2 {
  inset: auto -8% -22% -8%;
  height: 56%;
  opacity: 0.46;
  filter: blur(56px);
  animation-duration: 18s;
  animation-direction: alternate-reverse;
}

@keyframes auroraDrift {
  0% { transform: translate3d(-1.2%, 0.6%, 0) scale(1); }
  50% { transform: translate3d(1.4%, -1%, 0) scale(1.04); }
  100% { transform: translate3d(-0.8%, 1.1%, 0) scale(1.02); }
}
.hero-blur-layer {
  position: absolute;
  width: 36vw;
  height: 36vw;
  min-width: 260px;
  min-height: 260px;
  max-width: 520px;
  max-height: 520px;
  left: -8%;
  top: 22%;
  border-radius: 999px;
  pointer-events: none;
  z-index: 1;
  filter: blur(92px);
  opacity: 0.14;
  background: radial-gradient(circle, rgba(77,102,255,0.58) 0%, rgba(77,102,255,0) 70%);
  transition: transform 0.55s cubic-bezier(.22,1,.36,1);
}
.hero-blur-layer-2 {
  left: auto;
  right: -10%;
  top: 12%;
  opacity: 0.12;
  background: radial-gradient(circle, rgba(255,109,77,0.5) 0%, rgba(255,109,77,0) 72%);
}
.hero-blur-layer-3 {
  left: 28%;
  top: auto;
  bottom: -22%;
  opacity: 0.08;
  background: radial-gradient(circle, rgba(130,138,255,0.5) 0%, rgba(130,138,255,0) 72%);
}

.hero-motion-switch {
  border-color: rgba(255,255,255,.14);
}

.hero-mode-dynamic .hero-brand-aurora {
  opacity: 0.76;
  animation-duration: 8s;
}
.hero-mode-dynamic .hero-brand-aurora-2 {
  opacity: 0.56;
  animation-duration: 10s;
}
.hero-mode-dynamic .hero-blur-layer {
  opacity: 0.2;
  transition-duration: 0.35s;
}
.hero-mode-luxury .hero-brand-aurora {
  opacity: 0.56;
  animation-duration: 16s;
}

/* Contenedor raíz — ocupa todo el hero */
.hero-grid-root {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  overflow: hidden;
}

/* ---- Grid perspectiva ---- */
.hero-grid-perspective {
  position: absolute;
  bottom: 0;
  left: -10%;
  right: -10%;
  height: 58%;
  perspective: 420px;
  perspective-origin: 50% 0%;
}

.hero-grid-lines {
  position: absolute;
  inset: 0;
  background-image:
    /* líneas horizontales */
    repeating-linear-gradient(
      0deg,
      rgba(77, 102, 255, 0.10) 0px,
      rgba(77, 102, 255, 0.10) 1px,
      transparent 1px,
      transparent 48px
    ),
    /* líneas verticales */
    repeating-linear-gradient(
      90deg,
      rgba(77, 102, 255, 0.08) 0px,
      rgba(77, 102, 255, 0.08) 1px,
      transparent 1px,
      transparent 72px
    );
  transform: rotateX(52deg) scaleY(1.8);
  transform-origin: 50% 100%;
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.6) 30%,
    rgba(0,0,0,0.85) 65%,
    transparent 100%
  );
  mask-image: linear-gradient(
    to bottom,
    transparent 0%,
    rgba(0,0,0,0.6) 30%,
    rgba(0,0,0,0.85) 65%,
    transparent 100%
  );
  animation: gridPulse 6s ease-in-out infinite;
  will-change: opacity;
  display: none; /* Quitado según requerimiento */
}

@keyframes gridPulse {
  0%, 100% { opacity: 0.6; }
  50%       { opacity: 1.0; }
}

/* ---- Línea de scan ---- */
.hero-scan-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1.5px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(65, 234, 255, 0.0) 5%,
    rgba(65, 234, 255, 0.55) 35%,
    rgba(65, 234, 255, 0.85) 50%,
    rgba(65, 234, 255, 0.55) 65%,
    rgba(65, 234, 255, 0.0) 95%,
    transparent 100%
  );
  animation: scanDown 9s linear infinite;
  will-change: top;
  filter: blur(0.5px);
  display: none; /* Quitado según requerimiento */
}

@keyframes scanDown {
  0%   { top: 15%; opacity: 0; }
  8%   { opacity: 1; }
  88%  { opacity: 0.8; }
  100% { top: 82%; opacity: 0; }
}

/* ---- Glows laterales ---- */
.hero-side-glow {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 22vw;
  min-width: 140px;
  max-width: 280px;
  pointer-events: none;
}

.hero-side-glow-left {
  left: 0;
  background: radial-gradient(
    ellipse 100% 60% at 0% 42%,
    rgba(77, 102, 255, 0.22) 0%,
    rgba(77, 102, 255, 0.10) 40%,
    transparent 75%
  );
  animation: glowBreathLeft 7s ease-in-out infinite;
}

.hero-side-glow-right {
  right: 0;
  background: radial-gradient(
    ellipse 100% 60% at 100% 52%,
    rgba(255, 109, 77, 0.20) 0%,
    rgba(255, 109, 77, 0.09) 40%,
    transparent 75%
  );
  animation: glowBreathRight 8.5s ease-in-out infinite;
}

@keyframes glowBreathLeft {
  0%, 100% { opacity: 0.7; transform: scaleY(1);    }
  50%       { opacity: 1.0; transform: scaleY(1.06); }
}

@keyframes glowBreathRight {
  0%, 100% { opacity: 0.6; transform: scaleY(1);    }
  50%       { opacity: 1.0; transform: scaleY(1.08); }
}

/* ---- Orbe central de profundidad ---- */
.hero-center-orb {
  position: absolute;
  left: 50%;
  top: 54%;
  translate: -50% -50%;
  width: 55vw;
  max-width: 700px;
  aspect-ratio: 1;
  background: radial-gradient(
    circle,
    rgba(77, 102, 255, 0.07) 0%,
    rgba(77, 102, 255, 0.03) 45%,
    transparent 72%
  );
  animation: orbPulse 11s ease-in-out infinite;
}

@keyframes orbPulse {
  0%, 100% { opacity: 0.6; transform: scale(1);    }
  50%       { opacity: 1.0; transform: scale(1.05); }
}

/* Hero shimmer premium compartido (viewport-locked) */
.hero-shimmer {
  color: var(--coral);
  text-shadow: none;
}
@supports (-webkit-background-clip: text) or (background-clip: text) {
  .hero-shimmer {
    background: linear-gradient(
      90deg,
      #ff6d4d 0%,
      #ff6d4d 10%,
      #ffbe9e 18%,
      #828aff 28%,
      #5170ff 40%,
      #5170ff 52%,
      #aab2ff 62%,
      #ff6d4d 72%,
      #ff6d4d 82%,
      #ffbe9e 90%,
      #828aff 100%
    );
    background-size: 340% 100%;
    background-attachment: local;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0 transparent;
    color: transparent;
    animation: heroShimmer 5s ease-in-out infinite alternate;
    will-change: background-position;
  }
  .hero-mode-dynamic .hero-shimmer {
    animation-duration: 2.6s;
    animation-timing-function: ease-in-out;
  }
}
@keyframes heroShimmer {
  0%   { background-position: 90% center; }
  100% { background-position: 10% center; }
}

/* Footer: micro resplandor al hover en la marca */
@keyframes footer-brand-pulse {
  0%, 100% {
    text-shadow: 0 0 10px rgba(77, 102, 255, 0.35), 0 0 20px rgba(255, 109, 77, 0.2);
  }
  50% {
    text-shadow: 0 0 14px rgba(255, 109, 77, 0.45), 0 0 26px rgba(77, 102, 255, 0.25);
  }
}
.footer-brand-glow {
  transition: color 0.25s ease;
}
.footer-brand-glow:hover {
  animation: footer-brand-pulse 1.8s ease-in-out infinite;
}

/* Hex shape for avatars / circles */
.hex-clip {
  clip-path: polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
}

/* ================================================================
   LIGHT MODE — bloque único definitivo
   (reemplaza todos los bloques html.light anteriores)
   ================================================================ */

/* ── Variables ────────────────────────────────────────────────── */
:root {
  --manifiesto-bg: rgba(0, 3, 31, 0.72);
}


/* ── Scrollbar — Webkit (Chrome, Edge, Safari) ───────────────── */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(
    180deg,
    rgba(77, 102, 255, 0.55) 0%,
    rgba(255, 109, 77, 0.45) 100%
  );
  border-radius: 999px;
  border: 2px solid transparent;
  background-clip: padding-box;   /* crea el efecto "flotante" dentro del track */
  min-height: 40px;
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(
    180deg,
    rgba(77, 102, 255, 0.80) 0%,
    rgba(255, 109, 77, 0.70) 100%
  );
  background-clip: padding-box;
}

::-webkit-scrollbar-thumb:active {
  background: linear-gradient(
    180deg,
    #4D66FF 0%,
    #FF6D4D 100%
  );
  background-clip: padding-box;
}



/* ── Firefox scrollbar ───────────────────────────────────────── */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(77, 102, 255, 0.55) transparent;
}



/* ── Cursor — ocultar el nativo al usar el custom ────────────── */
/* Se activa solo en dispositivos con pointer fino (mouse real) */
@media (pointer: fine) {
  *, *::before, *::after {
    cursor: none !important;
  }
}

/* ================================================================
   LIGHT MODE — Glass cards definitivolo mas importante y reciente
   Pegar al FINAL de src/index.css (reemplaza bloques html.light anteriores)
   ================================================================ */

/* ── Variables ─────────────────────────────────────────────────── */
:root  { --manifiesto-bg: rgba(0, 3, 31, 0.72); }

/* ================================================================
   LIGHT MODE — bloque ÚNICO y DEFINITIVO
   Borrar TODOS los bloques html.light previos en index.css
   y pegar solo este al final.
   ================================================================ */

/* ── CSS custom property para color de texto en Enfoque ─────────
   La animación de Framer Motion usa 'var(--enfoque-text)'
   para saber el color final en cada modo.
   ──────────────────────────────────────────────────────────────── */
   :root                 { --enfoque-text: #F5F5F0; }   /* dark: blanco cálido */
   html.light            { --enfoque-text: #0A0A18; }   /* light: casi negro   */
   
   /* ── Variable fondo Manifiesto y secciones brand glass ─────────── */
   :root       { --manifiesto-bg: rgba(0, 3, 31, 0.72); }
   html.light {
     --manifiesto-bg: rgba(3, 6, 40, 0.9);
     --section-brand-glass: rgba(3, 6, 40, 0.32);
   }
   
   /* ── Body ────────────────────────────────────────────────────── */
   html.light body {
     background-color: #EEF1FF;
     color: #0A0A18;
   }
   
   /* ── Cursor nativo oculto (mouse) ───────────────────────────── */
   @media (pointer: fine) {
     html.light *, html.light *::before, html.light *::after { cursor: none !important; }
   }
   
   /* ── Glows laterales del Hero ──────────────────────────────── */
   html.light .hero-side-glow-left  { opacity: 0.28; }
   html.light .hero-side-glow-right { opacity: 0.24; }
   html.light .hero-blur-layer      { opacity: 0.10; }
   html.light .hero-blur-layer-2    { opacity: 0.08; }
   html.light .hero-brand-aurora    { opacity: 0.10; }
   
   /* ── Hero shimmer ───────────────────────────────────────────── */
   html.light .hero-shimmer {
     background: linear-gradient(
       90deg,
       #4D66FF 0%,
       #7A8CFF 20%,
       #828AFF 35%,
       #FF6D4D 50%,
       #828AFF 65%,
       #7A8CFF 80%,
       #4D66FF 100%
     ) !important;
     background-size: 280% 100% !important;
     -webkit-background-clip: text !important;
     background-clip: text !important;
     -webkit-text-fill-color: transparent !important;
     animation: heroShimmer 4.5s ease-in-out infinite alternate !important;
     will-change: background-position !important;
   }
   
    /* ── Secciones — fondo semitransparente base ───────────────── */
    html.light #enfoque,
    html.light #productos,
    html.light #contenido,
    html.light #connect {
      background: rgba(238, 241, 255, 0.35);
    }

    /* ── Enfoque card — macrotarjeta en light mode ──────────────── */
    html.light #enfoque [class*="rounded-section"] {
      background: rgba(3, 6, 40, 0.88) !important;
      border-color: rgba(77, 102, 255, 0.15) !important;
    }
    html.light #enfoque .dark\:text-white\/40 {
      color: rgba(245, 245, 240, 0.45) !important;
    }
    html.light #enfoque .dark\:text-white\/30 {
      color: rgba(245, 245, 240, 0.35) !important;
    }
    html.light #enfoque .dark\:text-white\/80 {
      color: rgba(245, 245, 240, 0.85) !important;
    }
    html.light #enfoque .dark\:bg-white\/10 {
      background: rgba(245, 245, 240, 0.12) !important;
    }
    html.light #enfoque .text-b-dark {
      color: #F5F5F0 !important;
    }
    html.light #enfoque .glass-blue {
      background: rgba(77, 102, 255, 0.15) !important;
      border-color: rgba(77, 102, 255, 0.25) !important;
    }
   
   /* ── Secciones con tinte azul de marca (principios + proceso) ─
      Crea el ritmo de "sección azulada / sección neutra"
      que da dinamismo al scroll en modo claro.
      ──────────────────────────────────────────────────────────── */
   html.light #principios {
     background: rgba(3, 6, 40, 0.9);
     backdrop-filter: blur(8px);
     -webkit-backdrop-filter: blur(8px);
     color: #F5F5F0;
   }
   
   html.light #proceso {
     background: rgba(3, 6, 40, 0.9);
     backdrop-filter: blur(8px);
     -webkit-backdrop-filter: blur(8px);
     color: #F5F5F0;
   }
   
   /* ── GLASS — semitransparente para ver el fondo ──────────────
      Antes: bg-white/60 → sólido.
      Ahora: 0.36 de opacidad → las cápsulas se ven a través.
      ──────────────────────────────────────────────────────────── */
   html.light .glass {
     background: rgba(255, 255, 255, 0.52) !important;
     border: 1px solid rgba(77, 102, 255, 0.18) !important;
     box-shadow:
       inset 0 1px 0 rgba(255, 255, 255, 0.72),
       0 4px 16px rgba(77, 102, 255, 0.06),
       0 1px 3px rgba(0, 0, 0, 0.03) !important;
     backdrop-filter: blur(8px) !important;
     -webkit-backdrop-filter: blur(8px) !important;
   }
   
   html.light .glass-blue {
     background: rgba(77, 102, 255, 0.12) !important;
     border-color: rgba(77, 102, 255, 0.28) !important;
     backdrop-filter: blur(6px) !important;
     -webkit-backdrop-filter: blur(6px) !important;
   }
   
   /* ── Cards del Manifiesto ───────────────────────────────────── */
   html.light #principios [class*="rounded-2xl"],
